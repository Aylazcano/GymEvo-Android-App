    <!-- Hint / Onboarding dialog -->
    <string name="hint_welcome_title">Bienvenue sur GymEvo ! 💪</string>
    <string name="hint_welcome_message">Voici un tour rapide pour commencer.</string>
    <string name="hint_tracker_title">Suivi d\'entraînement</string>
    <string name="hint_tracker_message">Suivez vos entraînements quotidiens avec le calendrier. Touchez un jour, ajoutez des exercices et enregistrez séries, répétitions et poids. Appui long pour sélectionner, réorganiser ou supprimer.</string>
    <string name="hint_exercises_title">Liste des exercices</string>
    <string name="hint_exercises_message">Parcourez plus de 800 exercices du catalogue. Touchez + pour créer des exercices personnalisés avec vos propres images. Marquez vos favoris avec ★, filtrez par groupe musculaire et triez par nom, popularité ou position musculaire.</string>
    <string name="hint_workouts_title">Liste des entraînements</string>
    <string name="hint_workouts_message">Créez des modèles d\'entraînement réutilisables. Touchez un entraînement pour développer et modifier ses exercices. Appui long pour sélectionner, copier, réorganiser ou supprimer. Importez des modèles dans le suivi pour démarrer une séance.</string>
    <string name="hint_statistics_title">Statistiques</string>
    <string name="hint_statistics_message">Consultez votre résumé d\'entraînement, records personnels, meilleurs exercices, fréquence hebdomadaire et répartition musculaire. Choisissez entre des plages de 4, 8 et 12 semaines.</string>
    <string name="hint_tips_title">Astuces</string>
    <string name="hint_tips_message">• Glissez dans le tiroir pour changer de section\n• Utilisez ★ pour marquer les favoris\n• Appui long pour le mode multi-sélection\n• Touchez l\'icône de recherche pour trouver des exercices\n• Le poids accepte les incréments de 0.5 — touchez le chiffre pour saisir directement</string>
