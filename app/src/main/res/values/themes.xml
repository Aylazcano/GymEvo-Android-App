<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.GymEvo" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Default (light mode) colors. -->
        <item name="colorPrimary">@color/gym_primary</item>
        <item name="colorPrimaryVariant">@color/gym_primary_variant</item>
        <item name="colorOnPrimary">@color/gym_on_primary</item>
        <item name="colorSecondary">@color/gym_secondary</item>
        <item name="colorSecondaryVariant">@color/gym_secondary_variant</item>
        <item name="colorOnSecondary">@color/gym_on_secondary</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <style name="Theme.GymEvo.Red" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gym_red_primary</item>
        <item name="colorPrimaryVariant">@color/gym_red_primary_variant</item>
        <item name="colorOnPrimary">@color/gym_red_on_primary</item>
        <item name="colorSecondary">@color/gym_red_secondary</item>
        <item name="colorSecondaryVariant">@color/gym_red_secondary_variant</item>
        <item name="colorOnSecondary">@color/gym_red_on_secondary</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <style name="Theme.GymEvo.Green" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gym_green_primary</item>
        <item name="colorPrimaryVariant">@color/gym_green_primary_variant</item>
        <item name="colorOnPrimary">@color/gym_green_on_primary</item>
        <item name="colorSecondary">@color/gym_green_secondary</item>
        <item name="colorSecondaryVariant">@color/gym_green_secondary_variant</item>
        <item name="colorOnSecondary">@color/gym_green_on_secondary</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <style name="Theme.GymEvo.Blue" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gym_blue_primary</item>
        <item name="colorPrimaryVariant">@color/gym_blue_primary_variant</item>
        <item name="colorOnPrimary">@color/gym_blue_on_primary</item>
        <item name="colorSecondary">@color/gym_blue_secondary</item>
        <item name="colorSecondaryVariant">@color/gym_blue_secondary_variant</item>
        <item name="colorOnSecondary">@color/gym_blue_on_secondary</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <style name="Theme.GymEvo.Gray" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gym_gray_primary</item>
        <item name="colorPrimaryVariant">@color/gym_gray_primary_variant</item>
        <item name="colorOnPrimary">@color/gym_gray_on_primary</item>
        <item name="colorSecondary">@color/gym_gray_secondary</item>
        <item name="colorSecondaryVariant">@color/gym_gray_secondary_variant</item>
        <item name="colorOnSecondary">@color/gym_gray_on_secondary</item>

        <!-- ensure surfaces/backgrounds and on-colors provide correct contrast -->
        <item name="colorSurface">@color/gym_gray_surface</item>
        <item name="colorOnSurface">@color/gym_gray_on_surface</item>
        <item name="android:colorBackground">@color/gym_gray_background</item>
        <item name="colorOnBackground">@color/gym_gray_on_background</item>

        <!-- dialogs use semantic on-colors so text remains readable in Gray -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog</item>

        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <style name="Theme.GymEvo.NoActionBar" parent="Theme.GymEvo">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.GymEvo.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.GymEvo.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>