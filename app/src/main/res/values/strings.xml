    <!-- Hint / Onboarding dialog -->
    <string name="hint_welcome_title">Welcome to GymEvo! 💪</string>
    <string name="hint_welcome_message">Here\'s a quick tour to help you get started.</string>
    <string name="hint_tracker_title">Workout Tracker</string>
    <string name="hint_tracker_message">Track your daily workouts with the calendar. Tap a day, add exercises, and log sets, reps, and weight. Long-press exercises to select, reorder, or delete them.</string>
    <string name="hint_exercises_title">Exercises List</string>
    <string name="hint_exercises_message">Browse 800+ exercises from the catalog. Tap + to create custom exercises with your own images. Star your favorites, filter by muscle group, and sort by name, popularity, or muscle position.</string>
    <string name="hint_workouts_title">Workouts List</string>
    <string name="hint_workouts_message">Create reusable workout templates. Tap a workout to expand and edit its exercises. Long-press to select workouts for copying, reordering, or deleting. Import templates into the Tracker to start a session.</string>
    <string name="hint_statistics_title">Statistics</string>
    <string name="hint_statistics_message">View your training summary, personal records, top exercises, weekly frequency, and muscle group distribution. Switch between 4, 8, and 12 week ranges.</string>
    <string name="hint_tips_title">Tips &amp; Tricks</string>
    <string name="hint_tips_message">• Swipe left/right in the drawer to switch sections\n• Use the ★ star to mark favorites\n• Long-press items for multi-select mode\n• Tap the search icon to find exercises quickly\n• Weight supports 0.5 increments — tap the number to type directly</string>
