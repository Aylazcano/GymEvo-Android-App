<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxBackgroundMode="outline"
            android:hint="@string/exercise_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_exercise_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:endIconMode="dropdown_menu"
            app:boxBackgroundMode="outline"
            android:hint="@string/exercise_targeted_muscles">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/edit_exercise_muscles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:minHeight="56dp"
                android:textSize="16sp"
                android:padding="16dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_exercise_start_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:boxBackgroundMode="outline"
            android:hint="@string/exercise_start_image">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_exercise_start_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_exercise_end_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:boxBackgroundMode="outline"
            android:hint="@string/exercise_end_image">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_exercise_end_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/layout_exercise_start_block"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="12dp">

                <FrameLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="4dp"
                    android:layout_gravity="center">

                    <ImageView
                        android:id="@+id/image_exercise_start_preview"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:background="@drawable/bg_image_placeholder"
                        android:contentDescription="@string/exercise_start_image"
                        android:scaleType="centerCrop"
                        android:src="@android:drawable/ic_menu_camera"
                        android:foreground="@null"
                        android:clickable="true"
                        android:focusable="true" />

                    <ImageButton
                        android:id="@+id/button_remove_start_image"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_close_circle"
                        android:contentDescription="@string/exercise_remove_image"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:tint="@android:color/white"
                        android:padding="4dp"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/text_exercise_start_filename"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                    android:text="" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_exercise_end_block"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <FrameLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="4dp"
                    android:layout_gravity="center">

                    <ImageView
                        android:id="@+id/image_exercise_end_preview"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:background="@drawable/bg_image_placeholder"
                        android:contentDescription="@string/exercise_end_image"
                        android:scaleType="centerCrop"
                        android:src="@android:drawable/ic_menu_camera"
                        android:foreground="@null"
                        android:clickable="true"
                        android:focusable="true" />

                    <ImageButton
                        android:id="@+id/button_remove_end_image"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_close_circle"
                        android:contentDescription="@string/exercise_remove_image"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:tint="@android:color/white"
                        android:padding="4dp"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/text_exercise_end_filename"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewEnd"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                    android:text="" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_exercise_star"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/exercise_starred" />

    </LinearLayout>
</ScrollView>
