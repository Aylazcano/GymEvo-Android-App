<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <!-- Exercise Header -->
    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/exercise_label"
        android:textAlignment="center"
        android:textAllCaps="true"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginBottom="8dp" />

    <ImageView
        android:id="@+id/image_exercise_preview"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="4dp"
        android:contentDescription="@string/exercise_label"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_menu_gallery" />

    <NumberPicker
        android:id="@+id/numberPickerExercise"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:scaleX="1.0"
        android:scaleY="0.9"
        android:descendantFocusability="blocksDescendants" />

    <!-- Metric Row 1: Series, Reps, Weight -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp">

        <!-- Headers Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/exercise_series"
                android:textAlignment="center"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/exercise_repetitions"
                android:textAlignment="center"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/exercise_weight_lbs"
                android:textAlignment="center"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Pickers Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <NumberPicker
                android:id="@+id/numberPickerSeries"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:scaleX="0.9"
                android:scaleY="0.9"
                android:descendantFocusability="blocksDescendants" />

            <NumberPicker
                android:id="@+id/numberPickerRepetitions"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:scaleX="0.9"
                android:scaleY="0.9"
                android:descendantFocusability="blocksDescendants" />

            <NumberPicker
                android:id="@+id/numberPickerWeight"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:scaleX="0.9"
                android:scaleY="0.9"
                android:descendantFocusability="blocksDescendants" />
        </LinearLayout>
    </LinearLayout>

    <!-- Metric Row 2: Time, Heart Rate -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="0dp">

        <!-- Headers Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/exercise_time_sec"
                android:textAlignment="center"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/exercise_heart_rate_bpm"
                android:textAlignment="center"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Pickers Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <NumberPicker
                android:id="@+id/numberPickerTime"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:scaleX="0.9"
                android:scaleY="0.9"
                android:descendantFocusability="blocksDescendants" />

            <NumberPicker
                android:id="@+id/numberPickerHeartRate"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:scaleX="0.9"
                android:scaleY="0.9"
                android:descendantFocusability="blocksDescendants" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
