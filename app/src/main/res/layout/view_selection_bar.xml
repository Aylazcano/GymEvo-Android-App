<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/selection_bar_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp"
    android:elevation="2dp"
    android:visibility="gone">

    <ImageButton
        android:id="@+id/button_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="8dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/action_back"
        android:src="@drawable/ic_arrow_back_24"
        android:tint="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/text_selection_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="0"
        android:textAppearance="?attr/textAppearanceSubtitle1"
        android:textColor="?attr/colorOnSurface" />

    <ImageButton
        android:id="@+id/button_move_up"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/action_move_up"
        android:src="@drawable/ic_arrow_up_24"
        android:tint="?attr/colorOnSurface" />

    <ImageButton
        android:id="@+id/button_move_down"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/action_move_down"
        android:src="@drawable/ic_arrow_down_24"
        android:tint="?attr/colorOnSurface" />

    <ImageButton
        android:id="@+id/button_delete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/action_delete"
        android:src="@android:drawable/ic_menu_delete"
        android:tint="?attr/colorOnSurface" />

</LinearLayout>
