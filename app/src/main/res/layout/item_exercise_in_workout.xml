<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/WorkoutRecyclerView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="2dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp"
    app:cardUseCompatPadding="false"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorPrimary">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:padding="3dp"
        android:background="?attr/colorSurface">

        <!-- main content (keeps same structure but drag/remove are overlays) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ExerciseIV"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="1dp"
                android:background="?attr/colorSurface"
                android:contentDescription="@string/exercise_label"
                android:scaleType="centerCrop"
                tools:srcCompat="@tools:sample/avatars" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="4"
                android:orientation="vertical"
                android:padding="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/colorPrimary"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/ExerciseNameTV"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:autoSizeTextType="uniform"
                        android:lines="1"
                        android:textColor="?attr/colorOnPrimary"
                        android:text="@string/exercise_label" />

                    <TextView
                        android:id="@+id/TargetedMusclesTV"
                        android:layout_width="120dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:padding="1dp"
                        android:autoSizeTextType="uniform"
                        android:lines="1"
                        android:textColor="?attr/colorOnPrimary"
                        android:text="@string/exercise_targeted_muscles" />

                    <LinearLayout
                        android:id="@+id/layout_kcal_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:id="@+id/KcalValueTV"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_kcal_badge"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="@string/stats_value_placeholder"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_metrics_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/colorSecondary"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/layout_metric_series"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/SeriesTV"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:gravity="center"
                            android:autoSizeTextType="uniform"
                            android:text="@string/exercise_series"
                            android:textColor="?attr/colorOnSecondary"
                            android:padding="1dp" />

                        <TextView
                            android:id="@+id/SeriesQtyTV"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:gravity="center"
                            android:autoSizeTextType="uniform"
                            android:text="@string/stats_value_placeholder"
                            android:textColor="?attr/colorOnSecondary"
                            android:padding="1dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_metric_reps"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/RepetitionsTV"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:gravity="center"
                            android:autoSizeTextType="uniform"
                            android:text="@string/exercise_repetitions"
                            android:textColor="?attr/colorOnSecondary"
                            android:padding="1dp" />

                        <TextView
                            android:id="@+id/RepetitionsQtyTV"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:gravity="center"
                            android:autoSizeTextType="uniform"
                            android:text="@string/stats_value_placeholder"
                            android:textColor="?attr/colorOnSecondary"
                            android:padding="1dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_metric_weight"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/WeightTV"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:gravity="center"
                            android:autoSizeTextType="uniform"
                            android:text="@string/exercise_weight_lbs"
                            android:textColor="?attr/colorOnSecondary"
                            android:padding="1dp" />

                        <TextView
                            android:id="@+id/WeightNumTV"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:gravity="center"
                            android:autoSizeTextType="uniform"
                            android:text="@string/stats_value_placeholder"
                            android:textColor="?attr/colorOnSecondary"
                            android:padding="1dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_metric_time"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/TimeTV"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:gravity="center"
                            android:autoSizeTextType="uniform"
                            android:text="@string/exercise_time_sec"
                            android:textColor="?attr/colorOnSecondary"
                            android:padding="1dp" />

                        <TextView
                            android:id="@+id/TimeQtyTV"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:gravity="center"
                            android:autoSizeTextType="uniform"
                            android:text="@string/stats_value_placeholder"
                            android:textColor="?attr/colorOnSecondary"
                            android:padding="1dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_metric_hr"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/HeartRateTV"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:gravity="center"
                            android:autoSizeTextType="uniform"
                            android:text="@string/exercise_heart_rate_bpm"
                            android:textColor="?attr/colorOnSecondary"
                            android:padding="1dp" />

                        <TextView
                            android:id="@+id/HeartRateQtyTV"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:gravity="center"
                            android:autoSizeTextType="uniform"
                            android:text="@string/stats_value_placeholder"
                            android:textColor="?attr/colorOnSecondary"
                            android:padding="1dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_metric_distance"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/DistanceTV"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:gravity="center"
                            android:autoSizeTextType="uniform"
                            android:text="@string/exercise_distance"
                            android:textColor="?attr/colorOnSecondary"
                            android:padding="1dp" />

                        <TextView
                            android:id="@+id/DistanceQtyTV"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:gravity="center"
                            android:autoSizeTextType="uniform"
                            android:text="@string/stats_value_placeholder"
                            android:textColor="?attr/colorOnSecondary"
                            android:padding="1dp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- overlay icons (do NOT affect layout flow) -->
        <ImageView
            android:id="@+id/image_drag_handle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="8dp"
            android:background="@drawable/overlay_icon_bg"
            android:contentDescription="@string/action_move"
            android:src="@drawable/ic_drag_handle_24"
            android:scaleType="center"
            android:padding="6dp"
            android:visibility="gone"
            app:tint="?attr/colorOnSurface" />

        <ImageView
            android:id="@+id/image_remove"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="8dp"
            android:background="@drawable/overlay_icon_bg"
            android:contentDescription="@string/action_delete"
            android:scaleType="center"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:visibility="gone"
            app:tint="?attr/colorOnSurface" />

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>

