<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardUseCompatPadding="false"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorPrimary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/layout_workout_header"
                android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/workout_item_padding"
            android:minHeight="@dimen/list_item_image_size">

                <!-- stacked content: title row + date/count so overlays center across header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_workout_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:autoSizeTextType="uniform"
                            android:background="@android:color/transparent"
                            android:hint="@string/workout_name_hint"
                            android:importantForAccessibility="yes"
                            android:inputType="textCapWords"
                            android:textAppearance="?attr/textAppearanceSubtitle1"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOnSurface"
                            android:textStyle="bold"
                            android:includeFontPadding="false"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="@dimen/star_touch_size" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_workout_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/workout_item_date_margin_top"
                        android:alpha="0.7"
                        android:text="@string/workout_item_date_placeholder"
                        android:textAppearance="?attr/textAppearanceBody2"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="2024-05-12" />

                    <TextView
                        android:id="@+id/text_workout_exercise_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/workout_item_count_margin_top"
                        android:alpha="0.8"
                        android:text="@string/workout_item_exercise_count"
                        android:textAppearance="?attr/textAppearanceBody2"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="5 exercises" />

                </LinearLayout>

                <!-- overlay icons (centered vertically across the stacked header) -->

                <!-- drag handle and remove remain in the frame; star is rendered last so it's visible on top -->
                <ImageView
                    android:id="@+id/image_drag_handle"
                    android:layout_width="@dimen/workout_item_icon_size"
                    android:layout_height="@dimen/workout_item_icon_size"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/overlay_icon_bg"
                    android:contentDescription="@string/action_move"
                    android:padding="6dp"
                    android:src="@drawable/ic_drag_handle_24"
                    android:visibility="gone"
                    app:tint="?attr/colorOnSurface" />

                <ImageView
                    android:id="@+id/image_remove"
                    android:layout_width="@dimen/workout_item_icon_size"
                    android:layout_height="@dimen/workout_item_icon_size"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/overlay_icon_bg"
                    android:contentDescription="@string/action_delete"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:visibility="gone"
                    app:tint="?attr/colorOnSurface" />

                <!-- star is an overlay and top-end clickable (large touch target) -->
                <ImageView
                    android:id="@+id/image_star"
                    android:layout_width="@dimen/star_touch_size"
                    android:layout_height="@dimen/star_touch_size"
                    android:layout_gravity="end|top"
                    android:layout_marginEnd="4dp"
                    android:padding="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/exercise_starred_label"
                    android:src="@android:drawable/btn_star_big_off"
                    android:visibility="visible"
                    app:tint="?attr/colorOnSurface" />

            </FrameLayout>

        <LinearLayout
            android:id="@+id/layout_workout_expand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_workout_exercises"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                tools:listitem="@layout/item_exercise_in_workout" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_add_exercise"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/exercise_add"
                android:text="@string/exercise_add"
                android:textColor="?attr/colorOnSurface"
                app:icon="@android:drawable/ic_input_add"
                app:iconTint="?attr/colorOnSurface" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
