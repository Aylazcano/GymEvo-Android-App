    <!-- Hint / Onboarding dialog -->
    <string name="hint_welcome_title">¡Bienvenido a GymEvo! 💪</string>
    <string name="hint_welcome_message">Aquí tienes un recorrido rápido para empezar.</string>
    <string name="hint_tracker_title">Seguimiento</string>
    <string name="hint_tracker_message">Registra tus entrenos diarios con el calendario. Toca un día, añade ejercicios y marca series, repeticiones y peso. Mantén pulsado para seleccionar, reordenar o eliminar.</string>
    <string name="hint_exercises_title">Lista de ejercicios</string>
    <string name="hint_exercises_message">Explora más de 800 ejercicios del catálogo. Toca + para crear ejercicios personalizados con tus propias imágenes. Marca favoritos con ★, filtra por grupo muscular y ordena por nombre, popularidad o posición muscular.</string>
    <string name="hint_workouts_title">Lista de entrenos</string>
    <string name="hint_workouts_message">Crea plantillas de entrenos reutilizables. Toca un entreno para expandir y editar sus ejercicios. Mantén pulsado para seleccionar, copiar, reordenar o eliminar. Importa plantillas al seguimiento para empezar una sesión.</string>
    <string name="hint_statistics_title">Estadísticas</string>
    <string name="hint_statistics_message">Consulta tu resumen de entrenamiento, récords personales, ejercicios principales, frecuencia semanal y distribución muscular. Elige entre rangos de 4, 8 y 12 semanas.</string>
    <string name="hint_tips_title">Trucos y consejos</string>
    <string name="hint_tips_message">• Desliza en el cajón para cambiar de sección\n• Usa ★ para marcar favoritos\n• Mantén pulsado para modo multi-selección\n• Toca el icono de búsqueda para encontrar ejercicios\n• El peso admite incrementos de 0.5 — toca el número para escribir directamente</string>
